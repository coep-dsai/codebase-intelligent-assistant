# ==============================================================================
# Codebase Intelligent Assistant Configuration
# ==============================================================================

# Local LLM Provider Configuration
LLM_PROVIDER="ollama"                          # "ollama" or "openai_compatible"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
LLM_MODEL="qwen2.5-coder:7b"                   # e.g., "qwen2.5-coder:7b", "qwen2.5-coder:14b"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_CONTEXT_WINDOW=16384

# Embeddings Configuration (Runs locally via ONNX on CPU)
EMBEDDING_PROVIDER="fastembed"                 # "fastembed" or "ollama"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Server & UI Configuration
SERVER_HOST="127.0.0.1"
SERVER_PORT=8000
POPUP_ALWAYS_ON_TOP=true
POPUP_WIDTH=480
POPUP_HEIGHT=720

# Repository & Safety Configuration
STORAGE_DIR=".codebase_agent"
REQUIRE_DIFF_CONFIRMATION=true                 # Require user approval before writing code changes
AUTO_GIT_BRANCH=false                          # Create isolated git branch for changes
MAX_AGENT_ITERATIONS=12                        # Prevent infinite agent loops
